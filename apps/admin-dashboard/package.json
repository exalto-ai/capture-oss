{
  "name": "@undertext/captured-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "check": "npm run check:frontend && npm run check:types",
    "check:frontend": "biome check .",
    "check:types": "tsc --noEmit",
    "format": "biome check --write .",
    "build": "npm run check:frontend && npm run check:api && npm run check:types && vite build",
    "test": "vitest run --config vitest.config.js",
    "preview": "vite preview --outDir ../../crates/capture-server/dashboard --host 127.0.0.1"
  },
  "dependencies": {
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@tanstack/react-query": "^5.108.4",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
