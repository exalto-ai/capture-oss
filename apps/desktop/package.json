{
  "name": "@exalto/capture-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check:frontend": "biome check .",
    "format": "biome check --write .",
    "build": "npm run check:frontend && tsc --noEmit && vite build",
    "test:browser": "vitest run --config vitest.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build:debug": "tauri build --debug --bundles app",
    "tauri:build": "tauri build",
    "tauri:dev:signed": "node scripts/signed-local.mjs --open",
    "tauri:build:signed:debug": "node scripts/signed-local.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@tanstack/react-query": "^5.103.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "lucide-react": "^0.539.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.10"
  }
}
