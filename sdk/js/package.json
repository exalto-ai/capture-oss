{
  "name": "@exalto/capture",
  "version": "0.0.1",
  "description": "Seal model-provider calls with an Exalto Capture notary and get the evidence back as bytes",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "files": ["index.js", "index.d.ts", "binding.js", "binding.d.ts", "*.node"],
  "engines": { "node": ">=20" },
  "napi": {
    "binaryName": "exalto-capture"
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  }
}
